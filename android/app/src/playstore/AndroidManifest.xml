<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Play build only (the GitHub build keeps src/main as is):
         - No "All files access": Play only allows it for file managers and
           similar. Folder scans use the system folder picker instead
           (FolderTree.kt), which grants access to the picked folder only.
         - No legacy storage flag (it only mattered for path-based scans).
         - HTTPS only (network_security_config). -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:node="remove" />

    <application
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:replace="android:usesCleartextTraffic"
        tools:remove="android:requestLegacyExternalStorage" />
</manifest>
